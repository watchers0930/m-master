generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}
model User { // users — 사용자 (멀티테넌시 핵심)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String   @map("password_hash")
  plan         String   @default("free") // free | starter | pro
  stripeId     String?  @map("stripe_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  domains            Domain[]
  visibilityQueries  VisibilityQuery[]
  settings           Setting[]
  channelCredentials ChannelCredential[]
  contents           Content[]
  abTests            AbTest[]
  contentPlans       ContentPlan[]
  ragDocuments       RagDocument[]
  costLedgers        CostLedger[]
  cafeTargets        CafeTarget[]
  subscriptions      Subscription[]
  ideaDocuments      IdeaDocument[]
  ideaPublishJobs    IdeaPublishJob[]    @relation("IdeaPublishJobOwner")
  ideaSchedules      IdeaSchedule[]     @relation("IdeaScheduleOwner")
  @@map("users")
}
model Subscription { // subscriptions — Stripe 구독
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  stripeSubId      String?   @unique @map("stripe_sub_id")
  plan             String    @default("free")
  status           String    @default("active") // active | past_due | canceled
  currentPeriodEnd DateTime? @map("current_period_end")
  createdAt        DateTime  @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("subscriptions")
}
model Content { // contents — 핵심 콘텐츠
  market        String    @default("ko-KR")
  id            String    @id @default(cuid())
  ownerId       String    @map("owner_id")
  channel       String    // 'blog' | 'instagram' | 'facebook'
  topic         String
  tone          String?
  keywords      String[]  // PostgreSQL text[]
  textBody      String?   @map("text_body") @db.Text
  imageUrl      String?   @map("image_url")
  bodyImageUrls String[]  @map("body_image_urls") // text[]
  scores        Json?     // { seo, readability, brand, legal, avg }
  costKrw       Float     @default(0) @map("cost_krw")
  status        String    @default("draft") // draft | scheduled | published | failed
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  owner         User           @relation(fields: [ownerId], references: [id])
  scheduleSlots ScheduleSlot[]
  abTestsAsA    AbTest[]       @relation("AbTestVariantA")
  abTestsAsB    AbTest[]       @relation("AbTestVariantB")
  @@index([ownerId, status])
  @@index([ownerId, createdAt])
  @@map("contents")
}
model ScheduleSlot { // schedule_slots — 발행 스케줄
  id          String    @id @default(cuid())
  ownerId     String    @map("owner_id")
  contentId   String?   @map("content_id")
  channel     String
  scheduledAt DateTime  @map("scheduled_at")
  publishedAt DateTime? @map("published_at")
  status      String    @default("scheduled") // scheduled | publishing | published | failed | cancelled
  mode        String    @default("manual") // manual | ai_auto
  externalId  String?   @map("external_id")
  externalUrl String?   @map("external_url")
  targetName  String?   @map("target_name")
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  @@index([ownerId])
  @@index([contentId])
  @@index([status, scheduledAt])
  @@map("schedule_slots")
}
model Setting { // settings — 유저별 설정
  defaultMarket   String @default("ko-KR") @map("default_market")
  id              String @id @default(cuid())
  ownerId         String @map("owner_id")
  brandGuide      Json   @default("{}") @map("brand_guide")
  promptTemplates Json   @default("{}") @map("prompt_templates")
  budgetMonthly   Int    @default(500000) @map("budget_monthly")
  alertThreshold  Float  @default(0.8) @map("alert_threshold")
  notifications   Json   @default("{}") @map("notifications")
  owner User @relation(fields: [ownerId], references: [id])
  @@unique([ownerId])
  @@map("settings")
}
model TopicRecommendation { // topic_recommendations — 주간 주제 추천
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  month     String?  // 'YYYY-MM' (레거시, nullable)
  weekStart String?  @map("week_start") // 'YYYY-MM-DD' (해당 주 월요일)
  topic     String
  score     Float
  factors   Json?
  channel   String   @default("blog")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([ownerId, weekStart, channel])
  @@index([ownerId, month, channel])
  @@map("topic_recommendations")
}
model AbTest { // ab_tests — A/B 테스트 (Content 2중 FK)
  id              String    @id @default(cuid())
  ownerId         String    @map("owner_id")
  topic           String
  channel         String
  tone            String?
  keywords        String[]
  variantAId      String    @map("variant_a_id")
  variantBId      String    @map("variant_b_id")
  status          String    @default("draft") // draft | running | completed | cancelled
  winner          String?   // 'a' | 'b' | 'tie'
  winnerDecidedBy String?   @map("winner_decided_by") // 'auto' | 'manual'
  measureDays     Int       @default(14) @map("measure_days")
  variantAUrl     String?   @map("variant_a_url")
  variantBUrl     String?   @map("variant_b_url")
  variantAPath    String?   @map("variant_a_path")
  variantBPath    String?   @map("variant_b_path")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  ga4Snapshot     Json?     @map("ga4_snapshot")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  owner    User    @relation(fields: [ownerId], references: [id])
  variantA Content @relation("AbTestVariantA", fields: [variantAId], references: [id], onDelete: Cascade)
  variantB Content @relation("AbTestVariantB", fields: [variantBId], references: [id], onDelete: Cascade)
  @@index([ownerId, status])
  @@index([status, startedAt])
  @@map("ab_tests")
}
model ContentPlan { // content_plans — 주간/월간 콘텐츠 계획
  id             String    @id @default(cuid())
  ownerId        String    @map("owner_id")
  monthKey       String?   @map("month_key") // 'YYYY-MM' (레거시, nullable)
  weekKey        String?   @map("week_key")  // 'YYYY-MM-DD' (해당 주 월요일)
  status         String    @default("active") // active | paused | completed
  autoGenerate   Boolean   @default(true) @map("auto_generate")
  lastExecutedAt DateTime? @map("last_executed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  owner User              @relation(fields: [ownerId], references: [id])
  items ContentPlanItem[]
  @@unique([ownerId, weekKey])
  @@unique([ownerId, monthKey])
  @@map("content_plans")
}
model ContentPlanItem { // content_plan_items — 월간 계획 개별 토픽
  id            String    @id @default(cuid())
  contentPlanId String    @map("content_plan_id")
  sortOrder     Int       @default(0) @map("sort_order")
  topic         String
  scheduledDate String    @map("scheduled_date") // 'YYYY-MM-DD'
  status        String    @default("planned") // planned | generating | generated | failed
  contentJobId  String?   @map("content_job_id") // 생성된 content.id
  generatedAt   DateTime? @map("generated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  plan ContentPlan @relation(fields: [contentPlanId], references: [id], onDelete: Cascade)
  @@index([contentPlanId, sortOrder])
  @@index([scheduledDate, status])
  @@map("content_plan_items")
}
model RagDocument { // rag_documents — RAG 문서 메타
  id          String   @id @default(cuid())
  ownerId     String   @map("owner_id")
  title       String
  sourceType  String   @map("source_type") // pdf | md | docx | url | manual
  storagePath String?  @map("storage_path")
  status      String   @default("uploaded") // uploaded | indexed | failed
  createdAt   DateTime @default(now()) @map("created_at")
  owner  User       @relation(fields: [ownerId], references: [id])
  chunks RagChunk[]
  @@index([ownerId, status])
  @@map("rag_documents")
}
model RagChunk { // rag_chunks — 벡터 임베딩
  id         String                       @id @default(cuid())
  docId      String                       @map("doc_id")
  chunkIndex Int                          @map("chunk_index")
  content    String                       @db.Text
  embedding  Unsupported("vector(1536)")?
  tokens     Int
  document RagDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@index([docId])
  @@map("rag_chunks")
}
model CostLedger { // cost_ledger — AI 비용 원장
  id         String   @id @default(cuid())
  ownerId    String   @map("owner_id")
  occurredAt DateTime @default(now()) @map("occurred_at")
  kind       String   // 'chat' | 'embedding' | 'image'
  tokensIn   Int      @default(0) @map("tokens_in")
  tokensOut  Int      @default(0) @map("tokens_out")
  krw        Float    @default(0)
  contentId  String?  @map("content_id")
  owner User @relation(fields: [ownerId], references: [id])
  @@index([ownerId, occurredAt])
  @@map("cost_ledger")
}
model AuditLog { // audit_log — 감사 로그 (INSERT only)
  id         String   @id @default(cuid())
  actor      String?
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([action, createdAt])
  @@map("audit_log")
}
model AnalyticsDaily { // analytics_daily — 일별 분석
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  date      String   // 'YYYY-MM-DD'
  channel   String
  contentId String?  @map("content_id")
  views     Int      @default(0)
  clicks    Int      @default(0)
  reach     Int      @default(0)
  saves     Int      @default(0)
  ctr       Float    @default(0)
  source    String   @default("ga4") // ga4 | naver | instagram | facebook
  @@unique([ownerId, date, channel, contentId, source])
  @@index([ownerId, date, channel])
  @@map("analytics_daily")
}
model ChannelCredential { // channel_credentials — 채널 자격증명
  id           String   @id @default(cuid())
  ownerId      String   @map("owner_id")
  channel      String   // 'naver_cafe' | 'instagram' | 'facebook'
  accessToken  String?  @map("access_token") @db.Text
  refreshToken String?  @map("refresh_token") @db.Text
  expiresAt    String?  @map("expires_at")
  meta         Json?
  updatedAt    DateTime @updatedAt @map("updated_at")
  owner User @relation(fields: [ownerId], references: [id])
  @@unique([ownerId, channel])
  @@map("channel_credentials")
}
model IdeaDocument { // idea_documents — 리치 에디터 문서
  id          String   @id @default(cuid())
  ownerId     String   @map("owner_id")
  title       String   @default("")
  body        String   @default("<p><br></p>") @db.Text
  channel     String   @default("blog") // blog | instagram | facebook | naver_cafe
  status      String   @default("draft") // draft | completed
  notes       String?  @db.Text
  bodyImageUrls String[] @default([]) @map("body_image_urls")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  publishJob  IdeaPublishJob?
  @@index([ownerId, createdAt])
  @@map("idea_documents")
}
model IdeaPublishJob { // idea_publish_jobs — 발행 예약 잡
  id          String    @id @default(cuid())
  ownerId     String    @map("owner_id")
  docId       String?   @unique @map("doc_id")
  title       String
  bodyHtml    String    @db.Text @map("body_html")
  channel     String    // blog | instagram | facebook | naver_cafe
  status      String    @default("pending") // pending | processing | done | failed
  scheduledAt DateTime? @map("scheduled_at")
  externalUrl String?   @map("external_url")
  error       String?   @db.Text
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  owner User          @relation("IdeaPublishJobOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  doc   IdeaDocument? @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@index([ownerId, status])
  @@index([status, scheduledAt])
  @@map("idea_publish_jobs")
}
model IdeaSchedule { // idea_schedules — 달력 계획 일정
  id            String   @id @default(cuid())
  ownerId       String   @map("owner_id")
  title         String
  scheduledDate String   @map("scheduled_date") // YYYY-MM-DD
  category      String   @default("general") // general | blog | youtube
  status        String   @default("planned") // planned | in_progress | completed
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  owner User @relation("IdeaScheduleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId, scheduledDate])
  @@map("idea_schedules")
}
model CafeTarget { // cafe_targets — 네이버 카페 발행 대상 목록
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  name      String
  clubId    String   @map("club_id")
  menuId    String   @map("menu_id")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner User @relation(fields: [ownerId], references: [id])
  @@map("cafe_targets")
}
model Domain {
  id           String   @id @default(cuid())
  ownerId      String   @map("owner_id")
  url          String // 정규화 호스트만 저장 (https·path·query 제거)
  market       String   @default("ko-KR")
  businessType String?  @map("business_type") // 자동감지 or 사용자입력
  createdAt    DateTime @default(now()) @map("created_at")
  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  seoAudits SeoAudit[]
  seoKeywords SeoKeyword[]
  consultingReports ConsultingReport[]
  visibilityQueries VisibilityQuery[]
  @@unique([ownerId, url]) // 같은 소유자·호스트 중복 차단. 서로 다른 소유자는 같은 호스트 가능
  @@index([ownerId])
  @@map("domains")
}
model VisibilityQuery {
  id                String   @id @default(cuid())
  ownerId           String   @map("owner_id")
  domainId          String?  @map("domain_id")
  query             String
  market            String   @default("ko-KR")
  engines           String[] // ["chatgpt","ai_overviews",...]
  brandAliases      String[] @map("brand_aliases")
  competitorAliases String[] @map("competitor_aliases")
  frequency         String   @default("weekly") // daily | weekly
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  owner     User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  domain    Domain?              @relation(fields: [domainId], references: [id], onDelete: SetNull)
  nextAttemptAt DateTime? @map("next_attempt_at")
  lastCheckedAt DateTime? @map("last_checked_at")
  attemptFailures Int @default(0) @map("attempt_failures")
  snapshots VisibilitySnapshot[]
  @@index([ownerId])
  @@index([domainId])
  @@index([ownerId, createdAt(sort: Desc), id])
  @@index([active, nextAttemptAt, lastCheckedAt])
  @@index([active, frequency]) // cron 스캔용
  @@map("visibility_queries")
}
model VisibilitySnapshot {
  id         String   @id @default(cuid())
  queryId    String   @map("query_id")
  engine     String
  captureConfig Json? @map("capture_config")
  status     String   @default("ok") // ok | no_result | failed | pending
  source     String? // llm_scraper | llm_responses | serp_aio | passthrough
  taskId     String?  @map("task_id") // 벤더 task_id (재폴링·중복방지)
  runKey     String?  @map("run_key") // 정기 실행 멱등 키 (중복 수집 방지)
  capturedAt DateTime @default(now()) @map("captured_at")
  answerText String   @default("") @map("answer_text") @db.Text
  citations  Json     @default("[]") // [{url,title?,position}]
  rawJson    Json?    @map("raw_json") // 원본(디버그 전용, 일반 응답 제외)
  costKrw    Float    @default(0) @map("cost_krw")
  failReason String?  @map("fail_reason") // 실패/판정대기 사유
  query    VisibilityQuery     @relation(fields: [queryId], references: [id], onDelete: Cascade)
  mentions VisibilityMention[]
  @@unique([queryId, engine, runKey]) // 같은 질문·엔진·실행구간 1회만
  @@index([queryId, capturedAt(sort: Desc)])
  @@map("visibility_snapshots")
}
model VisibilityMention {
  id         String  @id @default(cuid())
  snapshotId String  @map("snapshot_id")
  subject    String // brand | competitor | domain
  label      String // 매칭된 alias/도메인
  mentioned  Boolean
  cited      Boolean
  position   Int? // 인용 순서 (본문 순위 아님)
  sentiment  String? // positive | neutral | negative
  resolvable Boolean @default(true) // false=판정 불가(지표 분모 제외)
  snapshot VisibilitySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  @@index([snapshotId])
  @@map("visibility_mentions")
}
model SeoAudit {
  id             String    @id @default(cuid())
  domainId       String    @map("domain_id")
  market         String    @default("ko-KR")
  scope          String
  mode           String?
  technicalScore Int?      @map("technical_score")
  scoreVersion   String    @default("v1") @map("score_version")
  coverage       Float?
  checks         Json      @default("[]")
  status         String    @default("pending")
  runKey         String    @map("run_key")
  configHash     String    @map("config_hash")
  frozenConfig   Json      @map("frozen_config")
  costKrw        Float     @default(0) @map("cost_krw")
  failReason     String?   @map("fail_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  domain   Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  tasks    SeoTask[]
  rankings SeoRanking[]
  @@unique([domainId, runKey])
  @@index([domainId, createdAt(sort: Desc), id])
  @@map("seo_audits")
}
model SeoKeyword {
  id                String    @id @default(cuid())
  domainId          String    @map("domain_id")
  keyword           String
  normalizedKeyword String    @map("normalized_keyword")
  market            String    @default("ko-KR")
  engine            String
  searchVolume      Int?      @map("search_volume")
  volumeSource      String?   @map("volume_source")
  volumeScale       String?   @map("volume_scale")
  volumePeriod      String?   @map("volume_period")
  competition       Float?
  competitionRaw    String?   @map("competition_raw")
  rank              Int?
  rankStatus        String?   @map("rank_status")
  rankSource        String?   @map("rank_source")
  rankObservedAt    DateTime? @map("rank_observed_at")
  metricsUpdatedAt  DateTime? @map("metrics_updated_at")
  reservationOnly   Boolean   @default(false) @map("reservation_only")
  lastAuditId       String?   @map("last_audit_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  rankings SeoRanking[]
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  @@unique([domainId, market, engine, normalizedKeyword])
  @@index([domainId, market, engine])
  @@map("seo_keywords")
}
model SeoRanking {
  domainId        String    @map("domain_id")
  id              String    @id @default(cuid())
  keywordId       String    @map("keyword_id")
  auditId         String    @map("audit_id")
  market          String    @default("ko-KR")
  engine          String
  device          String    @default("desktop")
  rank            Int?
  rankAbsolute    Int?      @map("rank_absolute")
  matchedUrl      String?   @map("matched_url")
  status          String
  source          String
  sourceObservedAt DateTime? @map("source_observed_at")
  depth           Int?
  requestedPages  Int?      @map("requested_pages")
  returnedRange   Int?      @map("returned_range")
  runKey          String?   @map("run_key")
  capturedAt      DateTime  @default(now()) @map("captured_at")
  keyword SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  audit   SeoAudit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  @@unique([keywordId, auditId, source, device])
  @@index([domainId, capturedAt(sort: Desc), id])
  @@index([keywordId, capturedAt(sort: Desc), id])
  @@index([auditId])
  @@map("seo_rankings")
}
model SeoTask {
  id               String    @id @default(cuid())
  auditId          String    @map("audit_id")
  ownerId          String    @map("owner_id")
  operation        String
  itemKey          String    @map("item_key")
  runKey           String    @map("run_key")
  status           String    @default("pending")
  frozenInput      Json      @map("frozen_input")
  vendorTaskId     String?   @map("vendor_task_id")
  resultCheckpoint Json?     @map("result_checkpoint")
  costKrw          Float     @default(0) @map("cost_krw")
  reservedKrw      Float     @default(0) @map("reserved_krw")
  ledgerRecordedAt DateTime? @map("ledger_recorded_at")
  leaseUntil       DateTime? @map("lease_until")
  claimVersion     Int       @default(0) @map("claim_version")
  failReason       String?   @map("fail_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  audit SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  @@unique([auditId, operation, itemKey])
  @@unique([vendorTaskId])
  @@index([ownerId, status, leaseUntil])
  @@index([auditId])
  @@map("seo_tasks")
}

model ConsultingReport { // consulting_reports — 마케팅 컨설팅 리포트
  id                String    @id @default(cuid())
  domainId          String    @map("domain_id")
  ownerId           String    @map("owner_id")        // 설계 추가(위 사유)
  market            String    @default("ko-KR")       // 분석 시점 market
  diagnosisSummary  String?   @map("diagnosis_summary") @db.Text  // 완료 전 null
  strategyJson      Json?     @map("strategy_json")    // 채널 믹스·근거·한계. 완료 전 null
  budgetProposal    Json?     @map("budget_proposal")  // 완료 전 null
  priorityActions   Json?     @map("priority_actions") // 완료 전 null
  inputSnapshotHash String    @map("input_snapshot_hash")
  inputSnapshot     Json      @map("input_snapshot")   // 정규화 입력·evidence·소스 상태
  schemaVersion     String    @default("v1") @map("schema_version")
  promptVersion     String    @map("prompt_version")
  model             String                             // 'gpt-4o'
  status            String    @default("generating")   // generating | completed | failed | uncertain
  failCode          String?   @map("fail_code")        // 사용자 공개 가능 실패 코드
  attemptId         String    @map("attempt_id")       // LLM 호출 시도 ID(감사·정산 추적)
  ledgerId          String?   @map("ledger_id")        // CostLedger 연결. 중복 과금 방지(nullable unique)
  costKrw           Float     @default(0) @map("cost_krw")       // 정산된 실사용 비용
  reservedKrw       Float     @default(0) @map("reserved_krw")   // 진행 중 보유액(정산 시 0)
  startedAt         DateTime? @map("started_at")        // LLM 호출 경계
  generatedAt       DateTime? @map("generated_at")      // 성공 생성일. 완료 전 null
  createdAt         DateTime  @default(now()) @map("created_at")
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  @@unique([domainId, market, inputSnapshotHash])
  @@unique([ledgerId])
  @@index([domainId, createdAt(sort: Desc), id])
  @@index([ownerId, createdAt(sort: Desc), id])
  @@map("consulting_reports")
}
