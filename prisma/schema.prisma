generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id                     String         @id @default(cuid())
  name                   String
  domain                 String?
  industry               String?
  workingPath            String?
  status                 String         @default("active")
  analyticsSourceType    String?
  analyticsSourceId      String?
  analyticsSourceLabel   String?
  analyticsEndpointUrl   String?
  analyticsAccessKey     String?        @db.Text
  analyticsConnectedAt   DateTime?
  wordpressSiteUrl       String?
  wordpressUsername      String?
  wordpressStatus        String?
  wordpressCategoryNames String?
  wordpressTagNames      String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  brandProfiles          BrandProfile[]
  topics                 TopicCandidate[]
  contentJobs            ContentJob[]
  contentPlans           ContentPlan[]
}

model CmsSection {
  id          String    @id @default(cuid())
  key         String    @unique
  title       String
  description String?   @db.Text
  visible     Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       CmsItem[]

  @@index([visible, sortOrder])
}

model CmsItem {
  id          String     @id @default(cuid())
  sectionId   String
  slug        String
  title       String
  subtitle    String?
  clientName  String?
  periodLabel String?
  summary     String     @db.Text
  body        String?    @db.Text
  tags        String?    @db.Text
  imageUrl    String?
  linkUrl     String?
  status      String     @default("published")
  featured    Boolean    @default(false)
  visible     Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  section     CmsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, slug])
  @@index([sectionId, visible, sortOrder])
}

model BrandProfile {
  id           String   @id @default(cuid())
  projectId    String
  version      Int      @default(1)
  summary      String   @db.Text
  audience     String?  @db.Text
  tone         String?
  cta          String?  @db.Text
  bannedTerms  String?  @db.Text
  approved     Boolean  @default(false)
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, approved])
}

model TopicCandidate {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  intentType String?
  score      Float?
  rationale  String?  @db.Text
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ContentJob {
  id              String         @id @default(cuid())
  projectId       String
  topic           String
  objective       String?
  status          String         @default("pending")
  generationProvider String?
  publishProvider String?
  externalPostId  String?
  externalPostUrl String?
  publishedAt     DateTime?
  variantGroupId  String?
  variantLabel    String?
  adopted         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets          ContentAsset[]

  @@index([projectId, status])
  @@index([projectId, variantGroupId])
}

model ContentPlan {
  id             String            @id @default(cuid())
  projectId      String
  monthKey       String
  status         String            @default("draft")
  basisSummary   String?           @db.Text
  autoGenerate   Boolean           @default(false)
  generatedAt    DateTime?
  lastExecutedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items          ContentPlanItem[]

  @@unique([projectId, monthKey])
  @@index([projectId, monthKey])
}

model ContentPlanItem {
  id             String      @id @default(cuid())
  contentPlanId  String
  sortOrder      Int         @default(0)
  weekLabel      String
  topic          String
  intentType     String?
  objective      String?     @db.Text
  rationale      String?     @db.Text
  status         String      @default("planned")
  contentJobId   String?
  generatedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  contentPlan    ContentPlan @relation(fields: [contentPlanId], references: [id], onDelete: Cascade)

  @@index([contentPlanId, sortOrder])
  @@index([contentPlanId, status])
}

model ContentAsset {
  id              String        @id @default(cuid())
  contentJobId    String
  channel         String
  title           String?
  body            String        @db.Text
  cta             String?       @db.Text
  hashtags        String?       @db.Text
  metaDescription String?       @db.Text
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contentJob      ContentJob    @relation(fields: [contentJobId], references: [id], onDelete: Cascade)
  imageJobs       ImageJob[]

  @@index([contentJobId, channel])
}

model ImageJob {
  id             String       @id @default(cuid())
  contentAssetId String
  channelPreset  String
  prompt         String       @db.Text
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contentAsset   ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  imageAssets    ImageAsset[]

  @@index([contentAssetId, status])
}

model ImageAsset {
  id            String    @id @default(cuid())
  imageJobId     String
  role           String
  originalPath   String?
  composedPath   String?
  width          Int?
  height         Int?
  selected       Boolean   @default(false)
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  imageJob       ImageJob  @relation(fields: [imageJobId], references: [id], onDelete: Cascade)

  @@index([imageJobId, selected])
}
