generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ----------------------------------------------------------------
// users — 사용자 (멀티테넌시 핵심)
// ----------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String   @map("password_hash")
  plan         String   @default("free") // free | starter | pro
  stripeId     String?  @map("stripe_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  settings           Setting[]
  channelCredentials ChannelCredential[]
  contents           Content[]
  abTests            AbTest[]
  contentPlans       ContentPlan[]
  ragDocuments       RagDocument[]
  costLedgers        CostLedger[]
  cafeTargets        CafeTarget[]
  subscriptions      Subscription[]
  ideaDocuments      IdeaDocument[]
  ideaPublishJobs    IdeaPublishJob[]    @relation("IdeaPublishJobOwner")
  ideaSchedules      IdeaSchedule[]     @relation("IdeaScheduleOwner")

  @@map("users")
}

// ----------------------------------------------------------------
// subscriptions — Stripe 구독
// ----------------------------------------------------------------
model Subscription {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  stripeSubId      String?   @unique @map("stripe_sub_id")
  plan             String    @default("free")
  status           String    @default("active") // active | past_due | canceled
  currentPeriodEnd DateTime? @map("current_period_end")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

// ----------------------------------------------------------------
// contents — 핵심 콘텐츠
// ----------------------------------------------------------------
model Content {
  id            String    @id @default(cuid())
  ownerId       String    @map("owner_id")
  channel       String    // 'blog' | 'instagram' | 'facebook'
  topic         String
  tone          String?
  keywords      String[]  // PostgreSQL text[]
  textBody      String?   @map("text_body") @db.Text
  imageUrl      String?   @map("image_url")
  bodyImageUrls String[]  @map("body_image_urls") // text[]
  scores        Json?     // { seo, readability, brand, legal, avg }
  costKrw       Float     @default(0) @map("cost_krw")
  status        String    @default("draft") // draft | scheduled | published | failed
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  owner         User           @relation(fields: [ownerId], references: [id])
  scheduleSlots ScheduleSlot[]
  abTestsAsA    AbTest[]       @relation("AbTestVariantA")
  abTestsAsB    AbTest[]       @relation("AbTestVariantB")

  @@index([ownerId, status])
  @@index([ownerId, createdAt])
  @@map("contents")
}

// ----------------------------------------------------------------
// schedule_slots — 발행 스케줄
// ----------------------------------------------------------------
model ScheduleSlot {
  id          String    @id @default(cuid())
  ownerId     String    @map("owner_id")
  contentId   String?   @map("content_id")
  channel     String
  scheduledAt DateTime  @map("scheduled_at")
  publishedAt DateTime? @map("published_at")
  status      String    @default("scheduled") // scheduled | publishing | published | failed | cancelled
  mode        String    @default("manual") // manual | ai_auto
  externalId  String?   @map("external_id")
  externalUrl String?   @map("external_url")
  targetName  String?   @map("target_name")
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([contentId])
  @@index([status, scheduledAt])
  @@map("schedule_slots")
}

// ----------------------------------------------------------------
// settings — 유저별 설정
// ----------------------------------------------------------------
model Setting {
  id              String @id @default(cuid())
  ownerId         String @map("owner_id")
  brandGuide      Json   @default("{}") @map("brand_guide")
  promptTemplates Json   @default("{}") @map("prompt_templates")
  budgetMonthly   Int    @default(500000) @map("budget_monthly")
  alertThreshold  Float  @default(0.8) @map("alert_threshold")
  notifications   Json   @default("{}") @map("notifications")

  owner User @relation(fields: [ownerId], references: [id])

  @@unique([ownerId])
  @@map("settings")
}

// ----------------------------------------------------------------
// topic_recommendations — 주간 주제 추천
// ----------------------------------------------------------------
model TopicRecommendation {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  month     String?  // 'YYYY-MM' (레거시, nullable)
  weekStart String?  @map("week_start") // 'YYYY-MM-DD' (해당 주 월요일)
  topic     String
  score     Float
  factors   Json?
  channel   String   @default("blog")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId, weekStart, channel])
  @@index([ownerId, month, channel])
  @@map("topic_recommendations")
}

// ----------------------------------------------------------------
// ab_tests — A/B 테스트 (Content 2중 FK)
// ----------------------------------------------------------------
model AbTest {
  id              String    @id @default(cuid())
  ownerId         String    @map("owner_id")
  topic           String
  channel         String
  tone            String?
  keywords        String[]
  variantAId      String    @map("variant_a_id")
  variantBId      String    @map("variant_b_id")
  status          String    @default("draft") // draft | running | completed | cancelled
  winner          String?   // 'a' | 'b' | 'tie'
  winnerDecidedBy String?   @map("winner_decided_by") // 'auto' | 'manual'
  measureDays     Int       @default(14) @map("measure_days")
  variantAUrl     String?   @map("variant_a_url")
  variantBUrl     String?   @map("variant_b_url")
  variantAPath    String?   @map("variant_a_path")
  variantBPath    String?   @map("variant_b_path")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  ga4Snapshot     Json?     @map("ga4_snapshot")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  owner    User    @relation(fields: [ownerId], references: [id])
  variantA Content @relation("AbTestVariantA", fields: [variantAId], references: [id], onDelete: Cascade)
  variantB Content @relation("AbTestVariantB", fields: [variantBId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([status, startedAt])
  @@map("ab_tests")
}

// ----------------------------------------------------------------
// content_plans — 주간/월간 콘텐츠 계획
// ----------------------------------------------------------------
model ContentPlan {
  id             String    @id @default(cuid())
  ownerId        String    @map("owner_id")
  monthKey       String?   @map("month_key") // 'YYYY-MM' (레거시, nullable)
  weekKey        String?   @map("week_key")  // 'YYYY-MM-DD' (해당 주 월요일)
  status         String    @default("active") // active | paused | completed
  autoGenerate   Boolean   @default(true) @map("auto_generate")
  lastExecutedAt DateTime? @map("last_executed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  owner User              @relation(fields: [ownerId], references: [id])
  items ContentPlanItem[]

  @@unique([ownerId, weekKey])
  @@unique([ownerId, monthKey])
  @@map("content_plans")
}

// ----------------------------------------------------------------
// content_plan_items — 월간 계획 개별 토픽
// ----------------------------------------------------------------
model ContentPlanItem {
  id            String    @id @default(cuid())
  contentPlanId String    @map("content_plan_id")
  sortOrder     Int       @default(0) @map("sort_order")
  topic         String
  scheduledDate String    @map("scheduled_date") // 'YYYY-MM-DD'
  status        String    @default("planned") // planned | generating | generated | failed
  contentJobId  String?   @map("content_job_id") // 생성된 content.id
  generatedAt   DateTime? @map("generated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  plan ContentPlan @relation(fields: [contentPlanId], references: [id], onDelete: Cascade)

  @@index([contentPlanId, sortOrder])
  @@index([scheduledDate, status])
  @@map("content_plan_items")
}

// ----------------------------------------------------------------
// rag_documents — RAG 문서 메타
// ----------------------------------------------------------------
model RagDocument {
  id          String   @id @default(cuid())
  ownerId     String   @map("owner_id")
  title       String
  sourceType  String   @map("source_type") // pdf | md | docx | url | manual
  storagePath String?  @map("storage_path")
  status      String   @default("uploaded") // uploaded | indexed | failed
  createdAt   DateTime @default(now()) @map("created_at")

  owner  User       @relation(fields: [ownerId], references: [id])
  chunks RagChunk[]

  @@index([ownerId, status])
  @@map("rag_documents")
}

// ----------------------------------------------------------------
// rag_chunks — 벡터 임베딩
// ----------------------------------------------------------------
model RagChunk {
  id         String                       @id @default(cuid())
  docId      String                       @map("doc_id")
  chunkIndex Int                          @map("chunk_index")
  content    String                       @db.Text
  embedding  Unsupported("vector(1536)")?
  tokens     Int

  document RagDocument @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@map("rag_chunks")
}

// ----------------------------------------------------------------
// cost_ledger — AI 비용 원장
// ----------------------------------------------------------------
model CostLedger {
  id         String   @id @default(cuid())
  ownerId    String   @map("owner_id")
  occurredAt DateTime @default(now()) @map("occurred_at")
  kind       String   // 'chat' | 'embedding' | 'image'
  tokensIn   Int      @default(0) @map("tokens_in")
  tokensOut  Int      @default(0) @map("tokens_out")
  krw        Float    @default(0)
  contentId  String?  @map("content_id")

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId, occurredAt])
  @@map("cost_ledger")
}

// ----------------------------------------------------------------
// audit_log — 감사 로그 (INSERT only)
// ----------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  actor      String?
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("audit_log")
}

// ----------------------------------------------------------------
// analytics_daily — 일별 분석
// ----------------------------------------------------------------
model AnalyticsDaily {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  date      String   // 'YYYY-MM-DD'
  channel   String
  contentId String?  @map("content_id")
  views     Int      @default(0)
  clicks    Int      @default(0)
  reach     Int      @default(0)
  saves     Int      @default(0)
  ctr       Float    @default(0)
  source    String   @default("ga4") // ga4 | naver | instagram | facebook

  @@unique([ownerId, date, channel, contentId, source])
  @@index([ownerId, date, channel])
  @@map("analytics_daily")
}

// ----------------------------------------------------------------
// channel_credentials — 채널 자격증명
// ----------------------------------------------------------------
model ChannelCredential {
  id           String   @id @default(cuid())
  ownerId      String   @map("owner_id")
  channel      String   // 'naver_cafe' | 'instagram' | 'facebook'
  accessToken  String?  @map("access_token") @db.Text
  refreshToken String?  @map("refresh_token") @db.Text
  expiresAt    String?  @map("expires_at")
  meta         Json?
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id])

  @@unique([ownerId, channel])
  @@map("channel_credentials")
}

// ----------------------------------------------------------------
// idea_documents — 리치 에디터 문서
// ----------------------------------------------------------------
model IdeaDocument {
  id          String   @id @default(cuid())
  ownerId     String   @map("owner_id")
  title       String   @default("")
  body        String   @default("<p><br></p>") @db.Text
  channel     String   @default("blog") // blog | instagram | facebook | naver_cafe
  status      String   @default("draft") // draft | completed
  notes       String?  @db.Text
  bodyImageUrls String[] @default([]) @map("body_image_urls")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  publishJob  IdeaPublishJob?

  @@index([ownerId, createdAt])
  @@map("idea_documents")
}

// ----------------------------------------------------------------
// idea_publish_jobs — 발행 예약 잡
// ----------------------------------------------------------------
model IdeaPublishJob {
  id          String    @id @default(cuid())
  ownerId     String    @map("owner_id")
  docId       String?   @unique @map("doc_id")
  title       String
  bodyHtml    String    @db.Text @map("body_html")
  channel     String    // blog | instagram | facebook | naver_cafe
  status      String    @default("pending") // pending | processing | done | failed
  scheduledAt DateTime? @map("scheduled_at")
  externalUrl String?   @map("external_url")
  error       String?   @db.Text
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner User          @relation("IdeaPublishJobOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  doc   IdeaDocument? @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([status, scheduledAt])
  @@map("idea_publish_jobs")
}

// ----------------------------------------------------------------
// idea_schedules — 달력 계획 일정
// ----------------------------------------------------------------
model IdeaSchedule {
  id            String   @id @default(cuid())
  ownerId       String   @map("owner_id")
  title         String
  scheduledDate String   @map("scheduled_date") // YYYY-MM-DD
  category      String   @default("general") // general | blog | youtube
  status        String   @default("planned") // planned | in_progress | completed
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner User @relation("IdeaScheduleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, scheduledDate])
  @@map("idea_schedules")
}

// ----------------------------------------------------------------
// cafe_targets — 네이버 카페 발행 대상 목록
// ----------------------------------------------------------------
model CafeTarget {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  name      String
  clubId    String   @map("club_id")
  menuId    String   @map("menu_id")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id])

  @@map("cafe_targets")
}
