generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id                     String         @id @default(cuid())
  name                   String
  domain                 String?
  industry               String?
  workingPath            String?
  ga4PropertyId          String?
  status                 String         @default("active")
  wordpressSiteUrl       String?
  wordpressUsername      String?
  wordpressAppPasswordEncrypted String?
  wordpressStatus        String?
  wordpressCategoryNames String?
  wordpressTagNames      String?
  bloggerBlogId          String?
  bloggerAccessTokenEncrypted String?
  bloggerStatus          String?
  metaAccessTokenEncrypted String?
  metaTokenExpiresAt     DateTime?
  facebookPageId         String?
  instagramBusinessAccountId String?
  operationsAlertWebhookEncrypted String?
  alertPolicyMode        String         @default("failures-and-review")
  alertQuietHoursStart   String?
  alertQuietHoursEnd     String?
  alertTimezone          String         @default("Asia/Seoul")
  alertOnBlockedReadiness Boolean      @default(true)
  automationMode         String         @default("draft-only")
  automationRequireReview Boolean      @default(true)
  automationMinOverallScore Int        @default(75)
  automationMinRiskScore Int           @default(80)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  analyticsAccessKey     String?
  analyticsConnectedAt   DateTime?
  analyticsEndpointUrl   String?
  analyticsSourceId      String?
  analyticsSourceLabel   String?
  analyticsSourceType    String?
  brandProfiles          BrandProfile[]
  topics                 TopicCandidate[]
  contentJobs            ContentJob[]
  contentPlans           ContentPlan[]
  automationBatchRuns    AutomationBatchRun[]
  operators              ProjectOperator[]
  credentialChecks       CredentialCheckRun[]
}

model ProjectOperator {
  id            String                 @id @default(cuid())
  projectId     String
  name          String
  role          String
  accessKeyHash String
  active        Boolean                @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions      ProjectOperatorSession[]

  @@unique([projectId, name])
  @@index([projectId, active, role])
}

model ProjectOperatorSession {
  id            String          @id @default(cuid())
  operatorId     String
  tokenHash      String
  expiresAt      DateTime
  lastUsedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  operator       ProjectOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([operatorId, expiresAt])
}

model CredentialCheckRun {
  id          String   @id @default(cuid())
  projectId   String
  service     String
  kind        String
  status      String
  actorLabel  String?
  summary     String
  detail      String?  @db.Text
  expiresAt   DateTime?
  checkedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, service, checkedAt])
  @@index([projectId, createdAt])
}

model BrandProfile {
  id           String   @id @default(cuid())
  projectId    String
  version      Int      @default(1)
  summary      String   @db.Text
  audience     String?  @db.Text
  tone         String?
  cta          String?  @db.Text
  bannedTerms  String?  @db.Text
  approved     Boolean  @default(false)
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, approved])
}

model TopicCandidate {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  intentType String?
  score      Float?
  rationale  String?  @db.Text
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ContentJob {
  id              String         @id @default(cuid())
  projectId       String
  topic           String
  objective       String?
  status          String         @default("pending")
  generationProvider String?
  publishProvider String?
  externalPostId  String?
  externalPostUrl String?
  publishedAt     DateTime?
  variantGroupId  String?
  variantLabel    String?
  adopted         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets          ContentAsset[]
  publications    ChannelPublication[]

  @@index([projectId, status])
  @@index([projectId, variantGroupId])
}

model ChannelPublication {
  id              String     @id @default(cuid())
  contentJobId    String
  channel         String
  provider        String
  status          String     @default("pending")
  externalPostId  String?
  externalPostUrl String?
  payloadSummary  String?    @db.Text
  errorMessage    String?    @db.Text
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  contentJob      ContentJob @relation(fields: [contentJobId], references: [id], onDelete: Cascade)

  @@index([contentJobId, channel, createdAt])
  @@index([status, publishedAt])
}

model AutomationBatchRun {
  id           String   @id @default(cuid())
  projectId    String
  kind         String
  label        String
  actorLabel   String? 
  executionSource String?
  durationMs   Int?
  completedCount Int    @default(0)
  failedCount  Int      @default(0)
  itemsSnapshot String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ContentAsset {
  id              String        @id @default(cuid())
  contentJobId    String
  channel         String
  title           String?
  body            String        @db.Text
  cta             String?       @db.Text
  hashtags        String?       @db.Text
  metaDescription String?       @db.Text
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contentJob      ContentJob    @relation(fields: [contentJobId], references: [id], onDelete: Cascade)
  imageJobs       ImageJob[]

  @@index([contentJobId, channel])
}

model ImageJob {
  id             String       @id @default(cuid())
  contentAssetId String
  channelPreset  String
  prompt         String       @db.Text
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contentAsset   ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  imageAssets    ImageAsset[]

  @@index([contentAssetId, status])
}

model ImageAsset {
  id            String   @id @default(cuid())
  imageJobId    String
  role          String
  originalPath  String?
  composedPath  String?
  width         Int?
  height        Int?
  selected      Boolean  @default(false)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  imageJob      ImageJob @relation(fields: [imageJobId], references: [id], onDelete: Cascade)

  @@index([imageJobId, selected])
}

model CmsItem {
  id          String     @id
  sectionId   String
  slug        String
  title       String
  subtitle    String?
  clientName  String?
  periodLabel String?
  summary     String     @db.Text
  body        String?    @db.Text
  tags        String?    @db.Text
  imageUrl    String?
  linkUrl     String?
  status      String     @default("published")
  featured    Boolean    @default(false)
  visible     Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  section     CmsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, slug])
  @@index([sectionId, visible, sortOrder])
}

model CmsSection {
  id          String    @id
  key         String    @unique
  title       String
  description String?   @db.Text
  visible     Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  items       CmsItem[]

  @@index([visible, sortOrder])
}

model ContentPlan {
  id             String            @id
  projectId      String
  monthKey       String
  status         String            @default("draft")
  basisSummary   String?           @db.Text
  autoGenerate   Boolean           @default(false)
  generatedAt    DateTime?
  lastExecutedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items          ContentPlanItem[]

  @@unique([projectId, monthKey])
  @@index([projectId, monthKey])
}

model ContentPlanItem {
  id            String      @id
  contentPlanId String
  sortOrder     Int         @default(0)
  weekLabel     String
  publishAt     DateTime?
  topic         String
  intentType    String?
  objective     String?
  rationale     String?     @db.Text
  status        String      @default("planned")
  attemptCount  Int         @default(0)
  lastError     String?     @db.Text
  reviewSnapshot String?    @db.Text
  lastProcessedAt DateTime?
  contentJobId  String?
  generatedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  contentPlan   ContentPlan @relation(fields: [contentPlanId], references: [id], onDelete: Cascade)

  @@index([contentPlanId, sortOrder])
  @@index([contentPlanId, status])
}
