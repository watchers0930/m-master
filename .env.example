DATABASE_URL=
DIRECT_URL=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# Fallback property when a project-specific GA4 property is not saved
GA4_PROPERTY_ID=
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REFRESH_TOKEN=
# Required to encrypt persisted channel credentials for automation
CREDENTIAL_ENCRYPTION_SECRET=
# Optional cron auth secret for POST /api/automation/run
CRON_SECRET=
# Optional explicit public base URL for generated asset delivery links
PUBLIC_APP_URL=
# Optional Slack-compatible incoming webhook for automation warnings/failures
OPERATIONS_ALERT_WEBHOOK_URL=
# Required to bootstrap the first owner operator for a project
PROJECT_OPERATOR_BOOTSTRAP_SECRET=
